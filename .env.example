# Entorno local (copiar a .env). Nunca commitear .env con secretos reales.
# =========================================================================
# Compose
COMPOSE_PROJECT_NAME=navicash

# Backend (Django)
DEBUG=1
DJANGO_SECRET_KEY=dev-secret-key-cambiar-en-produccion
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_DB_ENGINE=django.db.backends.postgresql
POSTGRES_DB=navicash
POSTGRES_USER=navicash
POSTGRES_PASSWORD=navicash-dev-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS (orígenes del frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email (dev: consola; prod: SMTP de Resend/Brevo/SendGrid)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=changeme@example.com
DJANGO_EMAIL_HOST_PASSWORD=changeme
DJANGO_EMAIL_USE_TLS=True

# Autenticación y configuración de negocio
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
VERIFICATION_TOKEN_HOURS=24
RATE_TTL_MINUTES=60
# Proveedor de tasas: "dolarapi" (producción) o "static" (sin red / tests).
RATE_PROVIDER=dolarapi
# URL base de la SPA (para enlaces de verificación).
APP_BASE_URL=http://localhost:5173

# CAPTCHA (Cloudflare Turnstile). En dev sin claves se omite la verificación
# (CAPTCHA_DEV_BYPASS=True). En producción añade la clave secreta.
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
CAPTCHA_DEV_BYPASS=True
# Versión vigente de los términos de servicio (se graba al aceptar).
TERMS_VERSION=v1-2026-08

# Rate limit del chat del asistente Navi (peticiones por usuario/hora).
ASSISTANT_THROTTLE_RATE=30/hour

# Proveedor de IA del asistente Navi (Fase 2; en dev se usa el mock sin red).
AAI_PROVIDER=
AAI_API_KEY=
AAI_MODEL=gpt-4o-mini
AAI_BASE_URL=https://api.openai.com/v1

# Frontend (Vite)
VITE_API_URL=http://localhost:8000/api
# Site Key pública de Cloudflare Turnstile (la usa el widget del registro;
# vacía en dev: el widget no se muestra).
VITE_CAPTCHA_SITE_KEY=
# Target del proxy de dev de Vite (en Docker lo pisa el compose con http://api:8000).
VITE_API_PROXY_TARGET=http://localhost:8000

# =========================================================================
# Producción (rellenar en el despliegue real; nunca con placeholders)
# =========================================================================
# DEBUG vacío/ausente en prod (settings.py hace fail-fast).
# DJANGO_SECRET_KEY real (32+ bytes aleatorios), DJANGO_ALLOWED_HOSTS del dominio.

# Caché compartida: obligatoria en prod (Redis). Con gunicorn multi-worker los
# rate limits y las confirmaciones del asistente viven aquí, no por proceso.
REDIS_URL=redis://:clave@redis-host:6379/0

# PostgreSQL en proveedores gestionados exige TLS.
DJANGO_DB_SSLMODE=require

# Email transaccional (Brevo/Resend/SendGrid). En prod se prefiere Brevo:
# BREVO_API_KEY real + remitente verificado. EMAIL_VERIFICATION_REQUIRED=True
# obliga a verificar el correo antes de operar.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp-relay.brevo.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@example.com
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=NaviCash
EMAIL_VERIFICATION_REQUIRED=True

# CAPTCHA: en prod desactiva el bypass (debe quedar False) y pon las claves reales.
CAPTCHA_ENABLED=True
CAPTCHA_DEV_BYPASS=False

# Política de acceso: candados de fuerza bruta y periodo de gracia de baja.
MAX_FAILED_LOGIN_ATTEMPTS=15
LOGIN_LOCKOUT_MINUTES=15
ACCOUNT_DELETION_GRACE_DAYS=15

# Notificaciones Web Push (VAPID). Genera el par con:
#   python -c "from py_vapid import b64urlencode; from cryptography.hazmat.primitives import serialization; ..."
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Credencial para jobs internos (worker de push / jobs programados).
INTERNAL_TOKEN=
PUSH_MAX_PER_TICK=25
# Hora local de la notificación de registro (formato 0-23).
NUDGE_LOCAL_HOUR=9

# Throttle del transcribe de voz (voz -> texto).
TRANSCRIBE_THROTTLE_RATE=20/hour