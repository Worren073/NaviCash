# Entorno local (copiar a .env). Nunca commitear .env con secretos reales.
# =========================================================================
# Compose
COMPOSE_PROJECT_NAME=navicash

# Backend (Django)
DEBUG=1
DJANGO_SECRET_KEY=dev-secret-key-cambiar-en-produccion
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_DB_ENGINE=django.db.backends.postgresql
POSTGRES_DB=navicash
POSTGRES_USER=navicash
POSTGRES_PASSWORD=navicash-dev-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS (orígenes del frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email (dev: consola; prod: SMTP de Resend/Brevo/SendGrid)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=changeme@example.com
DJANGO_EMAIL_HOST_PASSWORD=changeme
DJANGO_EMAIL_USE_TLS=True

# Autenticación y configuración de negocio
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
VERIFICATION_TOKEN_HOURS=24
RATE_TTL_MINUTES=60
# Proveedor de tasas: "dolarapi" (producción) o "static" (sin red / tests).
RATE_PROVIDER=dolarapi
# URL base de la SPA (para enlaces de verificación).
APP_BASE_URL=http://localhost:5173

# CAPTCHA (Cloudflare Turnstile). En dev sin claves se omite la verificación
# (CAPTCHA_DEV_BYPASS=True). En producción añade la clave secreta.
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
CAPTCHA_DEV_BYPASS=True
# Versión vigente de los términos de servicio (se graba al aceptar).
TERMS_VERSION=v1-2026-08

# Frontend (Vite)
VITE_API_URL=http://localhost:8000/api
# Site Key pública de Cloudflare Turnstile (la usa el widget del registro;
# vacía en dev: el widget no se muestra).
VITE_CAPTCHA_SITE_KEY=
# Target del proxy de dev de Vite (en Docker lo pisa el compose con http://api:8000).
VITE_API_PROXY_TARGET=http://localhost:8000