# Dockerfile.prod — imagen de PRODUCCIÓN del frontend PWA (multi-stage).
# ---------------------------------------------------------------------------
# El Dockerfile normal es SOLO desarrollo (vite dev server); este construye
# la PWA estática y la sirve con nginx para poder emitir cabeceras de
# seguridad (CSP, X-Frame-Options, etc.) que Render Static Site no permite.
#
# Build args: VITE_API_URL y VITE_CAPTCHA_SITE_KEY se inyectan vía variables
# de entorno del servicio en el momento del build (Render las expone durante
# el build igual que en un Static Site); Vite las lee de process.env.

# Stage 1: build de la PWA con Node.
FROM node:22-alpine AS build

WORKDIR /app

ENV PATH=/app/node_modules/.bin:$PATH

# Las variables de la SPA tienen que declararse como ARG: en un build de Docker
# las variables de entorno del servicio NO llegan solas al build, y vite.config
# aborta si falta VITE_CAPTCHA_SITE_KEY.
# VITE_API_URL por defecto = /api (mismo origen vía proxy de nginx).
ARG VITE_API_URL=/api
ARG VITE_CAPTCHA_SITE_KEY
ENV VITE_API_URL=${VITE_API_URL} \
    VITE_CAPTCHA_SITE_KEY=${VITE_CAPTCHA_SITE_KEY}

COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then \
      npm ci --prefer-offline; \
    else \
      npm install; \
    fi

COPY . .
RUN npm run build

# Stage 2: nginx alpine sirviendo dist/ + proxy same-origin de /api.
FROM nginx:1.27-alpine

# ca-certificates es obligatorio: el proxy de /api habla HTTPS contra el
# servicio de la API y sin el CA bundle el handshake falla al arrancar.
RUN apk add --no-cache ca-certificates

# Configuración de nginx: SPA fallback + proxy /api + cabeceras de seguridad.
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
