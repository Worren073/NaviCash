# Dockerfile.prod — imagen de PRODUCCIÓN del frontend PWA (multi-stage).
# ---------------------------------------------------------------------------
# El Dockerfile normal es SOLO desarrollo (vite dev server); este construye
# la PWA estática y la sirve con nginx para poder emitir cabeceras de
# seguridad (CSP, X-Frame-Options, etc.) que Render Static Site no permite.
#
# Build args: VITE_API_URL y VITE_CAPTCHA_SITE_KEY se inyectan vía variables
# de entorno del servicio en el momento del build (Render las expone durante
# el build igual que en un Static Site); Vite las lee de process.env.

# Stage 1: build de la PWA con Node.
FROM node:22-alpine AS build

WORKDIR /app

ENV PATH=/app/node_modules/.bin:$PATH

COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then \
      npm ci --prefer-offline; \
    else \
      npm install; \
    fi

COPY . .
RUN npm run build

# Stage 2: nginx alpine sirviendo dist/ con cabeceras de seguridad.
FROM nginx:1.27-alpine

# Configuración de nginx: SPA fallback + cabeceras de seguridad + caché.
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
