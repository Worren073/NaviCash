# Entorno de la SPA NaviCash (apps/web). Copiar a .env dentro de apps/web.
# =========================================================================

# Site Key pública de Cloudflare Turnstile (widget anti-bot del registro).
# Obligatoria para el build de producción (falla si falta); en dev puede
# dejarse vacía y el widget simplemente no se muestra.
VITE_CAPTCHA_SITE_KEY=

# URL base de la API (p. ej. https://api.navicash.app/api).
# Si se omite, la app usa "/api" (en dev lo sirve el proxy de Vite).
VITE_API_URL=